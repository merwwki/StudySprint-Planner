# Copy to .env and fill in. .env is git-ignored; this file is committed.
# On a deployed host, set these in the dashboard instead: there is no .env there.

# Local (page 4):    postgresql://postgres:CHANGE_ME@localhost:5432/studysprint
# Hosted (page 5):   postgresql://user:pass@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/studysprint

# Comma-separated, no trailing slash, no path. An origin is scheme + host + port.
CORS_ORIGINS=http://localhost:5173

# Set to production on your host. Express and several libraries behave better,
# including not sending stack traces to your users.
NODE_ENV=development

# Do NOT set PORT locally or on the host. The host sets it for you.

# Shared application password. Replace this placeholder locally or in Render.
APP_PASSWORD=CHANGE_ME_TO_A_LONG_PASSWORD

# Random secret for signing authentication tokens; use at least 32 characters.
# Generate a unique value and set it in your local .env or Render settings.
AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
